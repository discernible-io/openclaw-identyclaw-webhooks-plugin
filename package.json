{
  "name": "@identyclaw/openclaw-identyclaw-webhooks-plugin",
  "version": "0.1.7",
  "description": "OpenClaw plugin — RODiT-signed webhook ingress (/hooks/wake, /hooks/agent) and outbound send_rodit_webhook",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external && esbuild send-rodit-webhook.ts --bundle --platform=node --format=esm --outfile=dist/send-rodit-webhook.js --packages=external",
    "prepare:publish": "npm run build && node ./scripts/verify-pack.mjs",
    "publish:clawhub:dry-run": "node ./scripts/publish-clawhub.mjs --dry-run",
    "publish:clawhub": "node ./scripts/publish-clawhub.mjs"
  },
  "keywords": [
    "identyclaw",
    "openclaw",
    "rodit",
    "webhooks",
    "plugin"
  ],
  "author": "IdentyClaw",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discernible-io/openclaw-identyclaw-webhooks-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/discernible-io/openclaw-identyclaw-webhooks-plugin/issues"
  },
  "homepage": "https://www.discernible.io/#developers",
  "dependencies": {
    "@rodit/rodit-auth-be": "9.12.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.27"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "openclaw": "2026.5.27"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.27",
      "minGatewayVersion": "2026.5.27"
    },
    "build": {
      "openclawVersion": "2026.5.27",
      "pluginSdkVersion": "2026.5.27"
    }
  }
}
